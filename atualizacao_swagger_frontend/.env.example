# PostgreSQL do serviço (usuários, aplicações, papéis, códigos)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/rh_auth

# Endereço público deste backend
BASE_URL=http://localhost:8000
JWT_ISSUER=http://localhost:8000
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio
# Para onde o login volta. Com o frontend em desenvolvimento:
FRONTEND_URL=http://localhost:3000/
# Frontends que podem chamar a API pelo navegador (separados por vírgula, sem barra no final)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth (redirect autorizado: BASE_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chaves RS256 (python -m scripts.gerar_chaves)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_SECONDS=900
AUTH_CODE_SECONDS=60
# Sessão do navegador: renova o token sozinha, sem novo login no Google
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30

# Aplicação do RH como cliente do Auth (segredo impresso pelo seed)
RH_CLIENT_ID=rh
RH_CLIENT_SECRET=

# SIP / Firebird (somente leitura) - mesmos nomes do projeto anterior
# Caminho do arquivo .FDB na SUA máquina (muda entre casa e prefeitura)
SIP_DB_HOST_FILE="/media/ademar/Novo volume/SIP_ANALISE_2.FDB"
SIP_DB_HOST=firebird
SIP_DB_PORT=3050
SIP_DB_DATABASE=/firebird/data/SIP_ANALISE_2.FDB
SIP_DB_USER=SIPANALISE
SIP_DB_PASSWORD=
SIP_DB_DIALECT=3
# Senha do SYSDBA do contêiner Firebird: a API usa para recriar o usuário
# SIP_DB_USER sozinha quando o contêiner é recriado
SIP_DB_SYSDBA_PASSWORD=TroqueEstaSenha123
SIP_DB_CHARSET=WIN1252
SIP_EMPRESA=001
# Situações que contam como vínculo ativo no diagnóstico (1 = Normal, 3 = Afastado)
SIP_SITUACOES_ATIVAS=1,3
DIAGNOSTICO_CACHE_MINUTES=10
